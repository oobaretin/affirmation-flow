# Optional: enables live OpenAI generation for New Affirmation on Today.
# Without this key, New Affirmation picks from the built-in library.
# VITE_OPENAI_API_KEY=sk-your-key-here

# Required for premium spoken affirmations (ElevenLabs). Keep in .env.local only — do not commit.
# VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Required for App Store subscriptions (RevenueCat public Apple API key).
# VITE_REVENUECAT_APPLE_API_KEY=appl_your_key_here

# Local simulator/testing only. Do NOT enable in production builds.
# VITE_SUBSCRIPTION_DEV_BYPASS=true
